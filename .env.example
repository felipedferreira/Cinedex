# Copy to `.env` and fill in. `.env` is gitignored.

# Password for the movies_rw Postgres user. Applied only when the postgres_data
# volume is initialized for the first time; to change it later, ALTER ROLE in the
# running database or wipe the cinedex_postgres_data volume.
DB_PASSWORD=replace-with-a-strong-password

# Full connection string for the database migrator and web service (Docker Compose).
# Host must be the postgres service name. Password must match DB_PASSWORD above.
DB_CONNECTION_STRING=Host=postgres;Database=movies;Username=movies_rw;Password=replace-with-a-strong-password

# Seq first-login password for user `admin`. Seq requires this on an empty
# seq_data volume, then prompts you to choose the permanent UI password.
SEQ_ADMIN_PASSWORD=replace-with-a-strong-password

# Seq ingestion API key token. Sent by the app as the X-Seq-ApiKey OTLP header and
# registered in Seq as an API key with the same token (seqcli apikey create --token ...).
SEQ_API_KEY=replace-with-your-seq-api-key

# Credentials for the Mailpit dev mail sink's SMTP server (compose writes them into a
# password file at container start; MP_SMTP_AUTH_ACCEPT_ANY stays false). The web service's
# SMTP client must send these same values. Dev-only — safe to pick anything; keep the
# password free of ':' since Mailpit splits user:password on the first colon.
MAILPIT_SMTP_USER=cinedex
MAILPIT_SMTP_PASSWORD=replace-with-a-dev-password
