{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "<SECRETS>"
  },
  "WebServer": {
    "RequestTimeoutSeconds": 30
  },
  "Features": {
    "ApiDocumentationEnabled": false
  },
  "Jwt": {
    "Issuer": "https://cinedex.local",
    "Audience": "cinedex-api",
    "SigningKey": "dev-only-signing-key-change-in-production-min-32-bytes-long!!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Frontend": {
    "BaseUrl": "http://localhost:9000"
  }
}
