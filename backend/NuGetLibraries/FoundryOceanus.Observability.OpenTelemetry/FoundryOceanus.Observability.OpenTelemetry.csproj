<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>

    <!-- NuGet Package Metadata (package-specific) -->
    <PackageId>FoundryOceanus.Observability.OpenTelemetry</PackageId>
    <Title>FoundryOceanus OpenTelemetry Observability</Title>
    <Authors>Felipe Ferreira</Authors>
    <Description>Shared OpenTelemetry logging and tracing setup for .NET services, exported to OTLP collectors (e.g., Seq).</Description>
    <PackageProjectUrl>https://github.com/felipedferreira/Cinedex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/felipedferreira/Cinedex</RepositoryUrl>
    <PackageTags>observability;opentelemetry;logging;tracing;seq;otlp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
