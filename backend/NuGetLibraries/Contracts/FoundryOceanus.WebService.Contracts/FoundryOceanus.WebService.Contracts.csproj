<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mark as packable (triggers conditional properties in Directory.Build.props) -->
    <IsPackable>true</IsPackable>

    <!-- NuGet Package Metadata (package-specific) -->
    <PackageId>FoundryOceanus.WebService.Contracts</PackageId>
    <Title>FoundryOceanus Web Service Contracts</Title>
    <Authors>FoundryOceanus Contributors</Authors>
    <Description>Shared DTOs and contract classes for web service APIs</Description>
    <PackageProjectUrl>https://github.com/felipedferreira/Cinedex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/felipedferreira/Cinedex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2026 FoundryOceanus Contributors</Copyright>
    <PackageTags>api;contracts;dto;rest</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Include README in package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude build-only analyzers from package dependencies -->
  <ItemGroup>
    <PackageReference Update="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
