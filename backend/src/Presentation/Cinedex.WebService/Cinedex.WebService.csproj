<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <UserSecretsId>c195f0ac-8b2a-42a3-aa5a-4507e0cc6b0d</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
        <PackageReference Include="FastEndpoints" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Adapters\Cinedex.Auth.Identity\Cinedex.Auth.Identity.csproj" />
      <ProjectReference Include="..\..\Adapters\Cinedex.Email.Smtp\Cinedex.Email.Smtp.csproj" />
      <ProjectReference Include="..\..\Adapters\Cinedex.Persistence.Postgres\Cinedex.Persistence.Postgres.csproj" />
      <ProjectReference Include="..\..\Application\Cinedex.Application.csproj" />
      <ProjectReference Include="..\..\Domain\Cinedex.Domain.csproj" />
      <ProjectReference Include="..\..\..\NuGetLibraries\Observability\FoundryOceanus.Observability.OpenTelemetry\FoundryOceanus.Observability.OpenTelemetry.csproj" />
      <ProjectReference Include="..\..\..\NuGetLibraries\Contracts\FoundryOceanus.WebService.Contracts\FoundryOceanus.WebService.Contracts.csproj" />
    </ItemGroup>


    <ItemGroup>
        <Content Remove="node_modules\**" />
        <None Remove="node_modules\**" />
        <Compile Remove="node_modules\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

    <!--
        Populates wwwroot before the .NET SDK's static-web-assets pipeline scans it during Build.
        All steps live in one target so their order is deterministic:
          1. Vite build (skipped in Docker via SkipFrontendBuild — the ts-build stage already emitted wwwroot).
             Vite runs with emptyOutDir, so it wipes wwwroot before writing the fresh output.
          2. Refresh backend/CHANGELOG.md from the canonical repo-root CHANGELOG.md. The root file is
             the only one meant to be edited by hand; the backend copy exists because the Docker build
             context is ./backend and cannot see the repo root. Local builds keep the copy current
             (commit the resulting diff); Docker builds skip this step (the root file is absent) and
             use the committed copy. CI fails if the two files differ.
          3. Copy backend/CHANGELOG.md into wwwroot on top of the Vite output. Runs unconditionally so
             both local and Docker builds end up with the changelog served under /movies-svc/CHANGELOG.md.
    -->
    <Target Name="BuildFrontend" BeforeTargets="BeforeBuild">
        <Exec Command="npx vite build"
              WorkingDirectory="$(MSBuildThisFileDirectory)"
              Condition="'$(SkipFrontendBuild)' != 'true'" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\..\CHANGELOG.md"
              DestinationFolder="$(MSBuildThisFileDirectory)..\..\.."
              SkipUnchangedFiles="true"
              Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\CHANGELOG.md')" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\CHANGELOG.md"
              DestinationFolder="$(MSBuildThisFileDirectory)wwwroot" />
    </Target>

</Project>
