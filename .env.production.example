# Environment for compose.production.yaml (the Dokploy deployment).
#
# On a Dokploy VPS you do NOT copy this to a file — paste the filled-in contents into the
# Compose application's **Environment** tab. Dokploy writes them to an `.env` next to the compose
# file at deploy time and keeps them out of the repository. Locally, `cp .env.production.example
# .env` works for a dry run (see docs/deployment/dokploy.md).
#
# Every value below is required unless marked optional. Compose substitutes an unset variable with
# an empty string and carries on, so a missing one surfaces later as a runtime failure, not as a
# deploy error.

# ── Public identity ──────────────────────────────────────────────────────────────────────────
# The origin the app is served from, scheme included, no trailing slash. Used for the JWT issuer
# and for the password-reset links in outgoing email.
PUBLIC_BASE_URL=https://cinedex.example.com

# The hostname Storybook is deployed at. Baked into the docs site at build time as the target of
# its design-system link, so changing it needs a rebuild.
STORYBOOK_BASE_URL=https://storybook.cinedex.example.com

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# Applied only when the postgres_data volume is first created. Changing it later requires an
# ALTER ROLE inside the running database — the variable alone does nothing.
DB_PASSWORD=

# Must match DB_PASSWORD, and the host must stay the `postgres` service name.
DB_CONNECTION_STRING=Host=postgres;Database=movies;Username=movies_rw;Password=

# ── Authentication ───────────────────────────────────────────────────────────────────────────
# THE ONE VALUE YOU CANNOT SKIP. appsettings.json ships a committed development key; deploy with
# it in place and anyone who can read this public repository can forge access tokens for your
# instance. Minimum 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=

# ── Outgoing email (a real SMTP provider — Mailpit is not deployed) ──────────────────────────
# Without these the forgot-password flow accepts the request and delivers nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@cinedex.example.com
# Optional, defaults to "Cinedex".
SMTP_FROM_NAME=Cinedex
# Optional, defaults to StartTls (port 587). Use SslOnConnect for port 465.
SMTP_SECURE_SOCKET_OPTIONS=StartTls

# ── Observability ────────────────────────────────────────────────────────────────────────────
# Seq's first-login password for `admin`. Only applied to an empty seq_data volume; Seq then makes
# you choose a permanent one.
SEQ_ADMIN_PASSWORD=

# The ingestion API key. Sent as the X-Seq-ApiKey OTLP header and registered inside Seq as an API
# key with this same token. Nothing breaks without it — logs simply never arrive.
SEQ_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────────
# Publishes the Scalar API reference at /movies-svc/api-docs/v1. Defaults to true, which suits a
# portfolio deployment; set false to keep the API surface undocumented publicly.
API_DOCS_ENABLED=true

# Tag applied to the images this stack builds. Leave as `latest` unless you are pushing to a
# registry and pinning releases.
IMAGE_TAG=latest
