{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Cinedex": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "<SECRETS>"
  },
  "RefreshTokenCleanup": {
    "Interval": "00:10:00",
