{
  "name": "cinedex-frontend",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w cinadex-app",
    "preview": "npm run preview -w cinadex-app",
    "storybook": "npm run storybook -w @cinedex/storybook",
    "build-storybook": "npm run build-storybook -w @cinedex/storybook",
    "docs-site": "npm run start -w @cinedex/docs-site",
    "build": "npm run build --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "core-js": false,
    "@swc/core": false
  }
}
